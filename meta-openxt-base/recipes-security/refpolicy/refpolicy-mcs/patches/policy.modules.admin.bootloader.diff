Upstream-Status: Inappropriate [OpenXT]

Wrap apt interfaces in optional_policy so bootloader can load when
apt=off (OpenXT modules-upstream.conf). Upstream calls apt_use_fds /
apt_use_ptys / apt_read_db / apt_manage_cache unconditionally under
distro_debian.

--- a/policy/modules/admin/bootloader.te
+++ b/policy/modules/admin/bootloader.te
@@ -192,11 +192,13 @@
 
 	libs_relabelto_lib_files(bootloader_t)
 
-	apt_use_fds(bootloader_t)
-	apt_use_ptys(bootloader_t)
-	# for apt-cache
-	apt_read_db(bootloader_t)
-	apt_manage_cache(bootloader_t)
+	optional_policy(`
+		apt_use_fds(bootloader_t)
+		apt_use_ptys(bootloader_t)
+		# for apt-cache
+		apt_read_db(bootloader_t)
+		apt_manage_cache(bootloader_t)
+	')
 
 	dpkg_read_db(bootloader_t)
 	dpkg_rw_pipes(bootloader_t)
