+ * Command line, e820 map, modules, ACPI pointers, and an inlined EFI
+ * memory map.  The map has to live in this Xen-resident buffer: after
+ * GETSEC[SENTER] only memory below 16MB and the Xen image are mapped.
+ */
+static u64 __initdata mbi2_data[0x8000];
 
 #define MULTIBOOT2_TAG_TYPE_XENEFI 0x58454301
