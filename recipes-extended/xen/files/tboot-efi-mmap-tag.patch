+    /*
+     * Inline the EFI descriptors in the standard tag.  Tboot reads this
+     * tag, and Xen restores its map from the same copy after SENTER.
+     */
+    {
+        UINTN map_size = 0, map_key, desc_size = 0;
+        UINT32 desc_ver = 0;
+        u32 tag_start = ((multiboot2_fixed_t *)mbi2_data)->total_size;
+        EFI_STATUS status;
+        multiboot2_tag_efi_mmap_t *emmap;
+
+        status = efi_bs->GetMemoryMap(&map_size, NULL, &map_key,
+                                      &desc_size, &desc_ver);
+        if ( status == EFI_BUFFER_TOO_SMALL && map_size && desc_size )
+        {
+            u32 exact, aligned;
+
+            map_size += 8 * desc_size;
+            emmap = mbi2_add_entry(offsetof(multiboot2_tag_efi_mmap_t,
+                                            efi_mmap[0]) + map_size);
+            status = efi_bs->GetMemoryMap(&map_size,
+                                          (EFI_MEMORY_DESCRIPTOR *)emmap->efi_mmap,
+                                          &map_key, &desc_size, &desc_ver);
+            if ( EFI_ERROR(status) )
+                ((multiboot2_fixed_t *)mbi2_data)->total_size = tag_start;
+            else
+            {
+                exact = offsetof(multiboot2_tag_efi_mmap_t, efi_mmap[0]) +
+                        map_size;
+                aligned = (exact + 7) & ~7;
+                emmap->type = MULTIBOOT2_TAG_TYPE_EFI_MMAP;
+                emmap->descr_size = desc_size;
+                emmap->descr_vers = desc_ver;
+                emmap->size = exact;
+                ((multiboot2_fixed_t *)mbi2_data)->total_size =
+                    tag_start + aligned;
+            }
+        }
+    }
+
