The 6.18 privcmd driver restricts hypercalls in every stubdom. An
HVM device model needs the unrestricted parameter on its kernel command
line so QEMU can create the ioreq server.

Upstream-Status: Inappropriate [OpenXT]

diff -ruN a/templates/default/new-vm b/templates/default/new-vm
--- a/templates/default/new-vm
+++ b/templates/default/new-vm
@@ -26,6 +26,7 @@
     "display": "none",
     "boot": "cd",
     "flask-label": "system_u:system_r:hvm_guest_t",
+    "stubdom-cmdline": "xen_privcmd.unrestricted=1",
     "hdtype": "ahci",
     "disk": {
       "0": {
