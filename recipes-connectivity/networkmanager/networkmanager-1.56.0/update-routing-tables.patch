 /*****************************************************************************/
 
+static void
+oxt_route_add(NMPlatform *platform, NMPNlmFlags flags, const NMPObject *obj, char **out_extack_msg)
+{
+    nm_auto_nlmsg struct nl_msg *nlmsg = NULL;
+    NMPObject                    copy;
+    guint32                      table;
+
+    if (NMP_OBJECT_GET_TYPE(obj) != NMP_OBJECT_TYPE_IP4_ROUTE)
+        return;
+
+    copy                        = *obj;
+    table                       = 30u + (guint32) copy.ip_route.ifindex;
+    copy.ip_route.table_coerced = nm_platform_route_table_coerce(table);
+    nlmsg = _nl_msg_new_route(RTM_NEWROUTE, flags & NMP_NLM_FLAG_FMASK, &copy);
+    if (!nlmsg) {
+        _NMLOG(LOGL_WARN,
+               "OpenXT: couldn't add routing table entry for ifindex %d",
+               copy.ip_route.ifindex);
+        return;
+    }
+
+    do_add_addrroute(platform,
+                     obj,
+                     nlmsg,
+                     NM_FLAGS_HAS(flags, NMP_NLM_FLAG_SUPPRESS_NETLINK_FAILURE),
+                     out_extack_msg);
+}
+
+static void
+oxt_route_delete(NMPlatform *platform, const NMPObject *obj)
+{
+    nm_auto_nlmsg struct nl_msg *nlmsg = NULL;
+    NMPObject                    copy;
+    guint32                      table;
+
+    if (NMP_OBJECT_GET_TYPE(obj) != NMP_OBJECT_TYPE_IP4_ROUTE)
+        return;
+
+    copy                        = *obj;
+    table                       = 30u + (guint32) copy.ip_route.ifindex;
+    copy.ip_route.table_coerced = nm_platform_route_table_coerce(table);
+    nlmsg                       = _nl_msg_new_route(RTM_DELROUTE, 0, &copy);
+    if (!nlmsg) {
+        _NMLOG(LOGL_WARN,
+               "OpenXT: couldn't delete routing table entry for ifindex %d",
+               copy.ip_route.ifindex);
+        return;
+    }
+
+    do_delete_object(platform, obj, nlmsg);
+}
+
