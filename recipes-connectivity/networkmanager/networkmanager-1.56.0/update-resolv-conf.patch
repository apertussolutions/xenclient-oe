 /*****************************************************************************/
 
+#define OPENXT_RESOLV_CONF "/var/volatile/etc/resolv.conf"
+
+static gboolean
+xc_rewrite_resolv_conf(NMDnsManager         *self,
+                       int                   ifindex,
+                       int                   addr_family,
+                       const NML3ConfigData *l3cd,
+                       GError              **error)
+{
+    NMResolvConfData  rc = {
+        .nameservers  = g_ptr_array_new(),
+        .searches     = g_ptr_array_new(),
+        .options      = g_ptr_array_new(),
+        .nis_domain   = NULL,
+        .nis_servers  = g_ptr_array_new(),
+        .has_trust_ad = NM_TERNARY_DEFAULT,
+    };
+    gs_strfreev char **searches    = NULL;
+    gs_strfreev char **nameservers = NULL;
+    gs_strfreev char **options     = NULL;
+    gs_free char      *resolv_path = NULL;
+    const char        *iface;
+    SpawnResult        success;
+
+    iface = nm_platform_link_get_name(NM_PLATFORM_GET, ifindex);
+    if (!iface || !iface[0])
+        return FALSE;
+
+    merge_one_l3cd(&rc, addr_family, ifindex, l3cd, FALSE);
+    if (rc.has_trust_ad == NM_TERNARY_TRUE)
+        g_ptr_array_add(rc.options, g_strdup(NM_SETTING_DNS_OPTION_TRUST_AD));
+
+    searches    = _ptrarray_to_strv(rc.searches);
+    nameservers = _ptrarray_to_strv(rc.nameservers);
+    options     = _ptrarray_to_strv(rc.options);
+    g_ptr_array_free(rc.nis_servers, TRUE);
+
+    /* resolv.conf.<iface> is what the per-bridge dnsmasq scripts read. */
+    resolv_path = g_strdup_printf("%s.%s", OPENXT_RESOLV_CONF, iface);
+    success     = update_resolv_conf(self,
+                                 resolv_path,
+                                 NM_CAST_STRV_CC(searches),
+                                 NM_CAST_STRV_CC(nameservers),
+                                 NM_CAST_STRV_CC(options),
+                                 error,
+                                 NM_DNS_MANAGER_RESOLV_CONF_MAN_FILE);
+    return success == SR_SUCCESS;
+}
+
 gboolean
 nm_dns_manager_set_ip_config(NMDnsManager         *self,
                              int                   addr_family,
@@ -2210,6 +2263,19 @@
             _LOGW("could not commit DNS changes: %s", error->message);
     }
 
+    if (l3cd) {
+        gs_free_error GError *xc_error = NULL;
+
+        if (!xc_rewrite_resolv_conf(self,
+                                    nm_l3_config_data_get_ifindex(l3cd),
+                                    addr_family,
+                                    l3cd,
+                                    &xc_error))
+            _LOGW("Could not commit DNS changes: (%d) %s",
+                  xc_error ? xc_error->code : -1,
+                  (xc_error && xc_error->message) ? xc_error->message : "(unknown)");
+    }
+
     return TRUE;
 }
 
